---
interface StatItem {
  number: string;
  label: string;
  formatted: string;
}

interface Props {
  stats: StatItem[];
}

const { stats } = Astro.props;
---
<div class="relative py-16 bg-gradient-to-b from-gray-50/50 to-gray-100/50">
  <div class="relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center transform hover:scale-105 transition-transform duration-300">
            <div 
              class="text-5xl font-bold text-primary-blue mb-3"
              data-stat-target={stat.number}
              data-stat-formatted={stat.formatted}
            >
              {stat.formatted}
            </div>
            <div class="text-gray-600 font-medium text-lg">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(var(--royal-blue) 1px, transparent 1px); background-size: 20px 20px;"></div>
</div>

<script>
  const observedElements = new Set();

  function animateValue(element: Element, end: string, duration: number = 1500) {
    if (observedElements.has(element)) return;
    observedElements.add(element);
    
    const formatted = element.getAttribute('data-stat-formatted');
    const endNum = parseInt(end.replace(/\D/g, ''));
    const start = 0;
    const increment = endNum / (duration / 16);
    let current = start;
    
    const timer = setInterval(() => {
      current += increment;
      if (current >= endNum) {
        clearInterval(timer);
        element.textContent = formatted;
      } else {
        element.textContent = Math.floor(current).toString() + (end.includes('+') ? '+' : '');
      }
    }, 16);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = entry.target.getAttribute('data-stat-target');
        if (target) {
          animateValue(entry.target, target);
        }
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-stat-target]').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  .text-primary-blue {
    color: var(--royal-blue);
  }
</style>