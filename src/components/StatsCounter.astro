---
const { stats } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12">
  {stats.map((stat) => (
    <div 
      class="text-center"
      data-stats-counter
      data-value={stat.value}
      data-prefix={stat.prefix || ""}
      data-suffix={stat.suffix || ""}
    >
      <div class="text-4xl font-bold text-primary-blue mb-2">
        {stat.prefix}{stat.value}{stat.suffix}
      </div>
      <div class="text-neutral-gray">{stat.label}</div>
    </div>
  ))}
</div>

<script>
const animate = (el: Element) => {
  const valueEl = el.querySelector('div:first-child')!;
  const value = parseInt(el.getAttribute('data-value') || '0', 10);
  const prefix = el.getAttribute('data-prefix') || '';
  const suffix = el.getAttribute('data-suffix') || '';
  
  if (isNaN(value)) return;

  let current = 0;
  const duration = 2000; // Increased duration to 2 seconds
  const steps = 100; // More steps for smoother animation
  const increment = value / steps;
  const interval = duration / steps;

  const timer = setInterval(() => {
    current += increment;
    if (current >= value) {
      current = value;
      clearInterval(timer);
    }
    valueEl.textContent = `${prefix}${Math.round(current)}${suffix}`;
  }, interval);
};

// Use Intersection Observer for better mobile support
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      animate(entry.target);
      observer.unobserve(entry.target);
    }
  });
}, {
  threshold: 0.1
});

// Observe all counter elements
document.querySelectorAll('[data-stats-counter]').forEach(el => {
  observer.observe(el);
});
</script>