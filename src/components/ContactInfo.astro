---
import { Icon } from 'astro-icon/components';

interface Props {
  address: string;
  email: string;
  phone: string;
}

const { address, email, phone } = Astro.props;

// Define a mapping of keys to icons with proper typing
const iconMapping: Record<string, string> = {
  address: 'map-marker',
  phone: 'phone',
  email: 'email',
} as const;

const contactFields = [
  { key: 'address' as const, value: address },
  { key: 'phone' as const, value: phone },
  { key: 'email' as const, value: email },
];
---
<div class="p-6 bg-white rounded-lg shadow-md" data-aos="fade-up">
  {/* Contact Information Section */}
  <h2 class="text-2xl font-bold mb-6 text-black">Contact Information</h2>
  <div class="space-y-4">
    {contactFields.map(({ key, value }) => (
      <div class="flex items-start gap-4">
        {/* Use the predefined icon mapping */}
        <Icon 
          name={`mdi:${iconMapping[key] || 'information-outline'}`} 
          class="w-10 h-7 text-royal-blue"
        />
        {/* Header and Value stacked vertically */}
        <div class="flex flex-col">
          <span class="text-lg font-medium text-black capitalize">{key.replace(/-/g, ' ')}</span>
          <span class="text-gray-600">{value}</span>
        </div>
      </div>
    ))}
  </div>
</div>