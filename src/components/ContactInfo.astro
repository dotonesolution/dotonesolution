---
import { Icon } from 'astro-icon/components';
import ContactDetails from '../data/ContactDetails.json';

// Define a mapping of keys to icons
const iconMapping = {
  Address: 'map-marker',
  Phone: 'phone',
  Email: 'email',
};
---
<div class="p-6 bg-white rounded-lg shadow-md" data-aos="fade-up">
  {/* Contact Information Section */}
  <h2 class="text-2xl font-bold mb-6 text-black">Contact Information</h2>
  <div class="space-y-4">
    {Object.entries(ContactDetails).map(([key, value]) => (
      <div class="flex items-start gap-4">
        {/* Use the predefined icon mapping */}
        <Icon 
          name={`mdi:${iconMapping[key] || 'information-outline'}`} 
          class="w-10 h-7 text-royal-blue"
        />
        {/* Header and Value stacked vertically */}
        <div class="flex flex-col">
          <span class="text-lg font-medium text-black capitalize">{key.replace(/-/g, ' ')}</span>
          <p class="text-gray-700">{value}</p>
        </div>
      </div>
    ))}
  </div>

  {/* Business Hours Section */}
  <div class="mt-8 border-t border-gray-200 pt-6">
    <h3 class="text-xl font-semibold mb-4 text-black">Business Hours</h3>
    <ul class="list-none space-y-2">
      <li class="text-gray-700">Monday - Friday: 8:30 AM - 5:00 PM</li>
      <li class="text-gray-700">Weekends: Closed</li>
    </ul>
  </div>
</div>