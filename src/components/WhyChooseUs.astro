---
import { Icon } from 'astro-icon/components';

interface Point {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  title: string;
  subtitle?: string;
  points: Point[];
  dark?: boolean;
}

const { title, subtitle, points, dark = false } = Astro.props;

const getIconForTitle = (title: string, defaultIcon: string): string => {
  const iconMapping: { [key: string]: string } = {
    "Expertise You Can Trust": "mdi:shield-check",
    "Customer-Centric Approach": "mdi:heart-multiple",
    "Tailored Solutions": "mdi:tools",
    "Innovative Technologies": "mdi:robot"
  };
  return iconMapping[title] || `mdi:${defaultIcon}`;
};
---

<section class={`py-20 relative overflow-hidden ${dark ? 'bg-primary-black text-white' : 'bg-white'}`}>
  <!-- Background elements -->
  <div class="absolute inset-0 z-0">
    {dark ? (
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
    ) : (
      <div class="absolute inset-0 bg-grid-pattern opacity-[0.03]"></div>
    )}
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-primary-blue/10 rounded-full blur-3xl"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-dark-blue/10 rounded-full blur-3xl"></div>
  </div>
  
  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <div class="text-center mb-16">
      {subtitle && (
        <div class={`inline-block px-6 py-2 mb-4 rounded-full ${dark ? 'bg-white/10 text-white' : 'bg-primary-blue/10 text-primary-blue'} font-medium text-sm`} data-aos="fade-up">
          {subtitle}
        </div>
      )}
      
      <h2 class={`text-3xl md:text-4xl font-bold ${dark ? 'text-white' : 'text-primary-black'}`} data-aos="fade-up" data-aos-delay="100">{title}</h2>
      
      <div class={`w-24 h-1 mx-auto my-6 rounded-full ${dark ? 'bg-white/20' : 'bg-gradient-to-r from-primary-blue to-dark-blue'}`} data-aos="fade-up" data-aos-delay="150"></div>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {points.map((point, idx) => (
        <div 
          class={`group ${dark ? 'glass-dark border border-white/10' : 'glass border border-gray-100'} rounded-xl shadow-custom transform-gpu transition-all duration-500 hover:shadow-futuristic hover:-translate-y-2 p-6`} 
          data-aos="fade-up" 
          data-aos-delay={idx * 100}
        >
          <div class="flex flex-col items-center">
            <div class="feature-icon-wrapper mb-6 relative">
              <div class={`w-16 h-16 rounded-xl flex items-center justify-center ${dark ? 'bg-gradient-to-br from-primary-blue to-dark-blue' : 'bg-gradient-to-br from-primary-blue/90 to-dark-blue/90'}`}>
                <Icon name={getIconForTitle(point.title, point.icon)} class="w-8 h-8 text-white" />
              </div>
              <div class="feature-icon-glow"></div>
            </div>
            
            <h3 class={`text-xl font-semibold mb-3 text-center ${dark ? 'text-white' : 'text-primary-black'}`}>{point.title}</h3>
            
            <p class={`text-center ${dark ? 'text-gray-300' : 'text-gray-600'}`}>{point.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bg-grid-pattern {
    background-image: 
      linear-gradient(rgba(28, 117, 187, 0.2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(28, 117, 187, 0.2) 1px, transparent 1px);
    background-size: 30px 30px;
  }

  .feature-icon-wrapper {
    position: relative;
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .feature-icon-wrapper::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 12px;
    padding: 1px;
    background: linear-gradient(135deg, var(--primary-blue), var(--dark-blue));
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .group:hover .feature-icon-wrapper {
    transform: scale(1.05);
  }

  .group:hover .feature-icon-wrapper::before {
    opacity: 1;
  }

  .feature-icon-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(
      circle at center,
      var(--primary-blue) 0%,
      transparent 70%
    );
    opacity: 0;
    filter: blur(10px);
    transition: opacity 0.5s ease;
    z-index: -1;
    border-radius: 20px;
  }

  .group:hover .feature-icon-glow {
    opacity: 0.3;
  }
</style>