---
import { Icon } from 'astro-icon/components';

interface Point {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  title: string;
  points: Point[];
}

const { title, points } = Astro.props;

const getIconForTitle = (title: string, defaultIcon: string): string => {
  const iconMapping: { [key: string]: string } = {
    "Expertise You Can Trust": "mdi:shield-check",
    "Customer-Centric Approach": "mdi:heart-multiple",
    "Tailored Solutions": "mdi:tools",
    "Innovative Technologies": "mdi:robot"
  };
  return iconMapping[title] || `mdi:${defaultIcon}`;
};
---

<section class="py-16 bg-gradient-to-br from-blue-50 via-white to-indigo-50">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-gray-900 to-gray-800 text-transparent bg-clip-text" data-aos="fade-up">{title}</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {points.map((point, idx) => (
        <div class="group bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 p-6 transform-gpu hover:-translate-y-1" data-aos="fade-up" data-aos-delay={idx * 100}>
          <div class="flex flex-col items-center">
            <div class="icon-wrapper mb-4">
              <div class="icon-inner">
                <Icon name={getIconForTitle(point.title, point.icon)} class="w-12 h-12 text-white" />
              </div>
              <div class="icon-glow"></div>
            </div>
            <h3 class="text-xl font-bold mb-3 bg-gradient-to-r from-gray-900 to-gray-800 text-transparent bg-clip-text text-center">{point.title}</h3>
            <p class="text-gray-700 text-center text-sm">{point.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .text-primary {
    color: var(--royal-blue);
  }
  
  .text-sky-blue {
    color: var(--sky-blue);
  }

  .icon-wrapper {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: linear-gradient(135deg, 
      var(--royal-blue),
      color-mix(in srgb, var(--sky-blue) 50%, var(--royal-blue))
    );
    box-shadow: 
      0 4px 12px rgba(0, 86, 210, 0.2),
      inset 0 -1px 2px rgba(0,0,0,0.1),
      inset 0 1px 2px rgba(255,255,255,0.2);
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    perspective: 1000px;
    transition: transform 0.3s ease;
  }

  .icon-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.05) 100%);
    position: relative;
    z-index: 2;
  }

  .icon-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(
      circle at center,
      rgba(255,255,255,0.8) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .icon-wrapper:hover .icon-glow {
    opacity: 0.4;
    animation: glow-rotate 2s linear infinite;
  }

  @keyframes glow-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .group:hover .icon-wrapper {
    transform: scale(1.05) rotateY(10deg);
  }

  .bg-grid-pattern {
    background-image: linear-gradient(to right, var(--royal-blue) 1px, transparent 1px),
                      linear-gradient(to bottom, var(--royal-blue) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .text-royal-blue {
    color: var(--royal-blue);
  }
</style>