---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'glass';
  class?: string;
  type?: 'button' | 'submit';
  size?: 'sm' | 'md' | 'lg';
}

const {
  href,
  variant = 'primary',
  class: className = '',
  type = 'button',
  size = 'md',
} = Astro.props;

const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg"
};

const baseStyles = "inline-flex items-center justify-center rounded-md font-medium transition-all duration-300 transform hover:translate-y-[-2px] focus:outline-none focus:ring-2 focus:ring-primary-blue focus:ring-opacity-50";

const variants = {
  primary: "bg-primary-blue text-white hover:shadow-lg hover:shadow-primary-blue/30",
  secondary: "bg-dark-blue text-white hover:shadow-lg hover:shadow-dark-blue/30",
  outline: "border-2 border-primary-blue text-primary-blue hover:bg-primary-blue hover:text-white",
  glass: "glass text-primary-black border border-white/20 hover:border-primary-blue/50 shadow-custom"
};

const styles = `${baseStyles} ${variants[variant]} ${sizeClasses[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={styles}>
      <slot />
    </a>
  ) : (
    <button type={type} class={styles}>
      <slot />
    </button>
  )
}