---
import { Icon } from 'astro-icon/components';
import services from '../data/services.json';

interface Service {
  title: string;
  description: string;
  icon?: string;
  link: string;
  features?: string[];
}

interface Props {
  services?: Service[];
  categories?: Array<{
    name: string;
    services: string[];
  }>;
}

const props = Astro.props;
// If categories are provided, map them to full service objects
const serviceItems = props.categories 
  ? props.categories.flatMap(category => 
      category.services.map(serviceName => 
        services.serviceList.find(s => s.title === serviceName)
      )
    ).filter(Boolean)
  : props.services || services.serviceList;
---

<section class="py-20 bg-gradient-to-b from-gray-100 to-blue-100 relative overflow-hidden">
  <!-- Layered subtle patterns with darker tones -->
  <div class="absolute inset-0">
    <!-- Primary pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#475569_0.8px,transparent_0.8px)] [background-size:20px_20px] opacity-[0.12]"></div>
    <!-- Secondary crossed pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(45deg,#475569_0.6px,transparent_0.6px),linear-gradient(-45deg,#475569_0.6px,transparent_0.6px)] [background-size:20px_20px] opacity-[0.12]"></div>
    <!-- Tertiary wave pattern -->
    <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,#1C75BB_0.6px,transparent_0.6px,transparent_10px)] opacity-[0.08]"></div>
  </div>
  
  <div class="container mx-auto px-4 relative">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-1.5 mb-4 rounded-full bg-primary-blue/10 text-primary-blue font-medium text-sm backdrop-blur-sm">
        Our Services
      </div>
      <h2 class="text-4xl font-bold text-gray-900 mb-4">
        What We Offer
      </h2>
      <div class="w-20 h-1.5 bg-primary-blue rounded-full mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {serviceItems.map((service) => (
        <div class="group cursor-pointer">
          <div class="bg-white/90 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 h-full border border-transparent hover:border-primary-blue hover:translate-y-[-8px] relative overflow-hidden backdrop-blur-sm">
            <!-- Decorative element -->
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary-blue/10 rounded-bl-[100px] transform translate-x-16 -translate-y-16 group-hover:translate-x-8 group-hover:-translate-y-8 group-hover:bg-primary-blue/20 transition-all duration-500"></div>
            
            <div class="relative">
              <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-primary-blue/20 text-primary-blue mb-6 group-hover:scale-125 group-hover:bg-primary-blue group-hover:text-white transition-all duration-300">
                <Icon name={`mdi:${service?.icon?.replace('mdi:', '') || 'apps'}`} class="w-7 h-7" />
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-4 group-hover:text-primary-blue transition-colors duration-300">
                {service?.title}
              </h3>
              
              <p class="text-gray-600 leading-relaxed">
                {service?.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>