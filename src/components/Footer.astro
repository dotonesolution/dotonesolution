---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-800 py-4">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0">
      <!-- Logo -->
      <a href="/" class="inline-block hover:opacity-90 transition-opacity">
        <img 
          src="/assets/images/logo/DotOne_Light.png" 
          alt="Dot One Solutions" 
          class="h-14 w-auto"
        />
      </a>

      <!-- Copyright -->
      <p class="text-gray-400 text-sm font-medium tracking-wide">
        © {currentYear} Dot One Solutions. All rights reserved.
      </p>
    </div>
  </div>
</footer>