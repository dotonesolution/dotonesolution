---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import company from '../data/company.json';
---

<section class="relative py-20 bg-white overflow-hidden">
  <!-- Circular design element -->
  <div class="absolute top-0 right-0 -mt-20 -mr-20">
    <div class="w-96 h-96 bg-primary-blue/5 rounded-full"></div>
  </div>
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20">
    <div class="w-64 h-64 bg-primary-blue/5 rounded-full"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <!-- Left Column -->
      <div class="flex-1 max-w-xl">
        <div class="inline-block px-4 py-1.5 mb-4 rounded-full bg-primary-blue/10 text-primary-blue font-medium text-sm">
          {company.about.tag}
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 leading-tight">
          {company.about.heading}
        </h2>
        <div class="w-20 h-1.5 bg-primary-blue rounded-full mb-8"></div>
      </div>

      <!-- Right Column -->
      <div class="flex-1 max-w-xl">
        <p class="text-gray-600 text-lg mb-8 leading-relaxed">
          {company.about.description}
        </p>
        <Button 
          href={company.about.button.link} 
          variant="primary"
          class="group"
        >
          <span class="flex items-center">
            {company.about.button.text}
            <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" />
          </span>
        </Button>
      </div>
    </div>
  </div>
</section>