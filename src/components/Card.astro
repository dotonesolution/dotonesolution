---
interface Props {
  title: string;
  description: string;
  mdiIcon: string;
  link: string;
  class?: string;
}
const { title, description, mdiIcon, link, class: className = '' } = Astro.props;
---

<a href={link} class={`bg-white rounded-lg p-6 shadow-custom transition-all duration-300 ${className}`} data-aos="fade-up">
  <div class="flex flex-col items-center text-center">
    {mdiIcon && (
      <span class="w-12 h-12 mb-4 text-primary-blue">
        <i class={`mdi:${mdiIcon}`}></i>
      </span>
    )}
    <h3 class="text-xl font-semibold mb-3 text-primary-black">{title}</h3>
    <p class="text-neutral-gray">{description}</p>
  </div>
</a>