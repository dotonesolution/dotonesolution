---
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  heading: string;
  text: string;
  consultationButton: { buttonText: string; buttonLink: string };
  learnMoreButton: { buttonText: string; buttonLink: string };
}
const { heading, text, consultationButton, learnMoreButton } = Astro.props;
---
<section class="relative py-24 overflow-hidden bg-gradient-to-br from-primary-black via-gray-900 to-primary-black">
  <!-- Decorative elements -->
  <div class="absolute inset-0 grid grid-cols-2 -skew-y-12 opacity-20">
    {Array.from({ length: 20 }).map(() => (
      <div class="border-t border-white/10"></div>
    ))}
  </div>

  <div class="relative max-w-4xl mx-auto px-4">
    <div class="text-center" data-aos="fade-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent">
        {heading}
      </h2>
      <p class="text-lg text-gray-300 leading-relaxed mb-8">
        {text}
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button 
          href={consultationButton.buttonLink} 
          variant="primary"
          class="group text-lg px-8 py-4 rounded-lg transform hover:scale-105 transition-all duration-300"
        >
          {consultationButton.buttonText}
          <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 inline-block transition-transform group-hover:translate-x-1" />
        </Button>
        <Button 
          href={learnMoreButton.buttonLink} 
          variant="secondary"
          class="text-lg px-8 py-4 rounded-lg border-2 hover:bg-white/10 transition-colors duration-300"
        >
          {learnMoreButton.buttonText}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>