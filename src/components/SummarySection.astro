---
interface Props {
  heading: string;
  text: string;
  consultationButton: { buttonText: string; buttonLink: string };
  learnMoreButton: { buttonText: string; buttonLink: string };
}
const { heading, text, consultationButton, learnMoreButton } = Astro.props;
---

<section class="bg-primary-black text-white py-12">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold mb-4">{heading}</h2>
    <p class="text-lg lg:text-xl mb-8">{text}</p>

    <!-- Buttons Container -->
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <!-- Schedule Consultation Button -->
      <a 
        href={consultationButton.buttonLink} 
        class="inline-block bg-primary-blue text-white py-2 px-6 rounded-full font-medium hover:bg-royal-blue transition-colors"
      >
        {consultationButton.buttonText}
      </a>

      <!-- Learn More Button -->
      <a 
        href={learnMoreButton.buttonLink} 
        class="inline-block bg-gray-700 text-white py-2 px-6 rounded-full font-medium hover:bg-gray-600 transition-colors"
      >
        {learnMoreButton.buttonText}
      </a>
    </div>
  </div>
</section>