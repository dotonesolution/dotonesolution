---
// src/components/ContactForm.astro
import Button from './Button.astro';
---

<div class="w-full p-6 bg-white rounded-lg shadow-custom" data-aos="fade-up">
  <h2 class="text-2xl font-bold mb-6 text-black">Send Us a Message</h2>
  <form 
    action="https://formsubmit.co/rahagi7833@shouxs.com" 
    method="POST"
    id="contactForm" 
    class="space-y-6"
  >
    <!-- Customization options for FormSubmit -->
    <input type="hidden" name="_subject" value="New Contact Form Submission">
    <input type="hidden" name="_template" value="table">
    <input type="hidden" name="_captcha" value="true">
    <input type="hidden" name="_next" value="https://dotonedev.netlify.app/thank-you">

    <!-- Name Input -->
    <div>
      <label for="name" class="block text-sm font-medium text-primary-black mb-2">
        Full Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-2 border border-neutral-gray rounded-md focus:outline-none focus:ring-2 focus:ring-primary-blue focus:border-transparent transition-all"
        placeholder="John Doe"
      />
    </div>

    <!-- Email Input -->
    <div>
      <label for="email" class="block text-sm font-medium text-primary-black mb-2">
        Email Address
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-2 border border-neutral-gray rounded-md focus:outline-none focus:ring-2 focus:ring-primary-blue focus:border-transparent transition-all"
        placeholder="john@example.com"
      />
    </div>

    <!-- Subject Input -->
    <div>
      <label for="subject" class="block text-sm font-medium text-primary-black mb-2">
        Subject
      </label>
      <input
        type="text"
        id="subject"
        name="subject"
        required
        class="w-full px-4 py-2 border border-neutral-gray rounded-md focus:outline-none focus:ring-2 focus:ring-primary-blue focus:border-transparent transition-all"
        placeholder="How can we help?"
      />
    </div>

    <!-- Message Input -->
    <div>
      <label for="message" class="block text-sm font-medium text-primary-black mb-2">
        Message
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="4"
        class="w-full px-4 py-2 border border-neutral-gray rounded-md focus:outline-none focus:ring-2 focus:ring-primary-blue focus:border-transparent transition-all resize-none"
        placeholder="Your message here..."
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div>
      <Button type="submit" variant="primary" class="w-full">
        Send Message
      </Button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    const button = form.querySelector('button');
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending...';
    }
    
    // The form will be handled by FormSubmit.co
    // This is just for the button state
    setTimeout(() => {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send Message';
      }
    }, 2000);
  });
</script>
