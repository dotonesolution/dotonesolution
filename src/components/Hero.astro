---
import PageSections from '../data/PageSections.json';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  section: keyof typeof PageSections.sections;
  showCta?: boolean;
}

const { section, showCta = false } = Astro.props;
const sectionData = PageSections.sections[section];

// Default gradient if not provided
const gradientBackground = 'gradientBackground' in sectionData 
  ? sectionData.gradientBackground 
  : 'linear-gradient(135deg, var(--royal-blue), var(--sky-blue))';
---

<section 
  class="relative min-h-[75vh] flex items-center justify-center text-center overflow-hidden"
>
  <div class="absolute inset-0 z-0" style={`background: ${gradientBackground};`}>
    <div class="absolute inset-0 bg-pattern opacity-10"></div>
    <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-white to-transparent"></div>
  </div>
  
  <!-- Animated shapes -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <div class="floating-shape absolute -top-24 -left-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
    <div class="floating-shape-delayed absolute top-1/2 -right-48 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
  </div>

  <div class="container relative z-10 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 animate-gradient">
        {sectionData.title}
      </h1>
      
      <p class="text-lg md:text-xl text-gray-600 mb-8 leading-relaxed">
        {sectionData.description}
      </p>

      {showCta && 'primaryCta' in sectionData && (
        <div class="flex justify-center gap-4 items-center">
          <Button href={sectionData.primaryCta.link} variant="primary" class="group">
            {sectionData.primaryCta.text}
            <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 inline-block transition-transform group-hover:translate-x-1" />
          </Button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .animate-gradient {
    background-size: 200% auto;
    animation: gradient 8s linear infinite;
  }

  .floating-shape {
    animation: float 20s infinite;
  }

  .floating-shape-delayed {
    animation: float 20s infinite;
    animation-delay: -10s;
  }

  .bg-pattern {
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(5%, 5%) rotate(5deg);
    }
    50% {
      transform: translate(0, 10%) rotate(0deg);
    }
    75% {
      transform: translate(-5%, 5%) rotate(-5deg);
    }
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
