---
interface Props {
  mission: {
    title: string;
    description: string;
  };
  vision: {
    title: string;
    description: string;
  };
  journey: {
    title: string;
    milestones: Array<{
      year: string;
      title: string;
      description: string;
    }>;
  };
}

const { mission, vision, journey } = Astro.props;
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Mission & Vision Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold text-primary mb-4">{mission.title}</h2>
        <p class="text-gray-600 leading-relaxed">{mission.description}</p>
      </div>
      <div class="bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold text-primary mb-4">{vision.title}</h2>
        <p class="text-gray-600 leading-relaxed">{vision.description}</p>
      </div>
    </div>

    <!-- Journey Timeline Section -->
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-center mb-12">{journey.title}</h2>
      <div class="relative max-w-4xl mx-auto">
        <!-- Timeline Line -->
        <div class="absolute left-[20px] md:left-1/2 transform md:-translate-x-1/2 h-full w-1 timeline-gradient"></div>
        
        <!-- Timeline Items -->
        <div class="space-y-8 relative">
          {journey.milestones.map((milestone, index) => (
            <div class={`flex flex-col md:flex-row md:items-center ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
              <div class={`pl-12 md:pl-0 md:w-5/12 ${index % 2 === 0 ? 'md:text-right md:pr-8' : 'md:text-left md:pl-8'}`}>
                <div class="milestone-card bg-white p-6 rounded-lg shadow-lg transition-all duration-300">
                  <!-- Connecting line for mobile -->
                  <div class="absolute left-[-28px] top-1/2 md:hidden w-7 h-[2px] timeline-gradient"></div>
                  <span class="text-xl font-bold text-primary block mb-2">{milestone.year}</span>
                  <h3 class="text-xl font-semibold mb-2">{milestone.title}</h3>
                  <p class="text-gray-600">{milestone.description}</p>
                </div>
              </div>
              <div class="absolute left-0 md:static md:w-2/12 flex justify-center">
                <div class="journey-point-wrapper">
                  <div class="journey-point-inner"></div>
                  <div class="journey-point-outer"></div>
                  <div class="journey-point-pulse"></div>
                </div>
              </div>
              <div class="hidden md:block md:w-5/12"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-primary {
    color: var(--royal-blue);
  }

  .timeline-gradient {
    background: linear-gradient(to bottom, var(--royal-blue), var(--sky-blue));
  }

  .journey-point-wrapper {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journey-point-inner {
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    position: relative;
    z-index: 3;
    box-shadow: 0 0 0 2px var(--royal-blue);
  }

  .journey-point-outer {
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--sky-blue);
    border-radius: 50%;
    z-index: 2;
  }

  .journey-point-pulse {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--royal-blue);
    opacity: 0.2;
    z-index: 1;
    animation: journey-pulse 2s ease-out infinite;
  }

  .milestone-card {
    position: relative;
    overflow: hidden;
  }

  .milestone-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(to bottom, var(--royal-blue), var(--sky-blue));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .milestone-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
  }

  .milestone-card:hover::before {
    opacity: 1;
  }

  @keyframes journey-pulse {
    0% {
      transform: scale(1);
      opacity: 0.2;
    }
    50% {
      transform: scale(1.3);
      opacity: 0.1;
    }
    100% {
      transform: scale(1);
      opacity: 0.2;
    }
  }
</style>