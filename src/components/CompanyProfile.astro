---
import { Icon } from 'astro-icon/components';

interface Props {
  mission: {
    title: string;
    description: string;
  };
  vision: {
    title: string;
    description: string;
  };
  journey: {
    title: string;
    milestones: Array<{
      year: string;
      title: string;
      description: string;
    }>;
  };
}
const { mission, vision, journey } = Astro.props;
---

<section class="py-20 bg-gradient-to-br from-blue-50 via-white to-indigo-50 relative overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[radial-gradient(#1C75BB_0.5px,transparent_0.5px)] [background-size:24px_24px] opacity-[0.15]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <!-- Mission & Vision Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-20">
      <!-- Mission Card -->
      <div class="group" data-aos="fade-right" data-aos-duration="1000">
        <div class="bg-white p-8 rounded-2xl shadow-custom transform-gpu transition-all duration-500 hover:shadow-custom-lg hover:-translate-y-2 relative overflow-hidden backdrop-blur-sm border border-white/20">
          <div class="absolute inset-0 bg-gradient-to-br from-primary-blue/10 to-dark-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="icon-badge mission-gradient mb-6 relative z-20 group-hover:scale-110 transition-transform duration-500">
            <Icon name="mdi:rocket-launch" class="w-6 h-6 text-white" />
          </div>
          <h2 class="text-2xl font-bold mb-4 relative z-10 text-gray-900 group-hover:text-primary-blue transition-colors duration-300">{mission.title}</h2>
          <p class="text-gray-700 leading-relaxed relative z-10">{mission.description}</p>
        </div>
      </div>

      <!-- Vision Card -->
      <div class="group" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="100">
        <div class="bg-white p-8 rounded-2xl shadow-custom transform-gpu transition-all duration-500 hover:shadow-custom-lg hover:-translate-y-2 relative overflow-hidden backdrop-blur-sm border border-white/20">
          <div class="absolute inset-0 bg-gradient-to-br from-dark-blue/10 to-primary-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="icon-badge vision-gradient mb-6 relative z-20 group-hover:scale-110 transition-transform duration-500">
            <Icon name="mdi:telescope" class="w-6 h-6 text-white" />
          </div>
          <h2 class="text-2xl font-bold mb-4 relative z-10 text-gray-900 group-hover:text-primary-blue transition-colors duration-300">{vision.title}</h2>
          <p class="text-gray-700 leading-relaxed relative z-10">{vision.description}</p>
        </div>
      </div>
    </div>

    <!-- Journey Timeline Section -->
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-900 relative" data-aos="fade-up">
        <span class="relative">
          {journey.title}
          <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-12 h-1 bg-gradient-to-r from-primary-blue to-dark-blue rounded-full"></div>
        </span>
      </h2>
      <div class="relative max-w-4xl mx-auto">
        <!-- Timeline Line -->
        <div class="absolute left-[20px] md:left-1/2 transform md:-translate-x-1/2 h-full w-1 timeline-gradient opacity-50"></div>
        
        <!-- Timeline Items -->
        <div class="space-y-12 relative">
          {journey.milestones.map((milestone, index) => (
            <div 
              class={`flex flex-col md:flex-row md:items-center ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`} 
              data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
              data-aos-duration="1000"
              data-aos-delay={index * 100}
            >
              <div class={`pl-12 md:pl-0 md:w-5/12 ${index % 2 === 0 ? 'md:text-right md:pr-8' : 'md:text-left md:pl-8'}`}>
                <div class="milestone-card bg-white p-6 rounded-2xl shadow-custom transition-all duration-300 backdrop-blur-sm border border-white/20">
                  <div class="absolute left-[-28px] top-1/2 md:hidden w-7 h-[2px] timeline-gradient"></div>
                  <div class="year-badge inline-block mb-3">
                    <span class="text-xl font-bold text-white">{milestone.year}</span>
                  </div>
                  <h3 class="text-xl font-semibold mb-2 text-gray-900">{milestone.title}</h3>
                  <p class="text-gray-600">{milestone.description}</p>
                </div>
              </div>
              <div class="absolute left-0 md:static md:w-2/12 flex justify-center">
                <div class="journey-point-wrapper">
                  <div class="journey-point-inner"></div>
                  <div class="journey-point-outer"></div>
                  <div class="journey-point-pulse"></div>
                </div>
              </div>
              <div class="hidden md:block md:w-5/12"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .shadow-custom {
    box-shadow: 0 4px 6px -1px rgba(28, 117, 187, 0.1), 0 2px 4px -1px rgba(28, 117, 187, 0.06);
  }

  .shadow-custom-lg {
    box-shadow: 0 10px 25px -5px rgba(28, 117, 187, 0.2), 0 8px 10px -6px rgba(28, 117, 187, 0.1);
  }

  .icon-badge {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(28, 117, 187, 0.15);
  }

  .mission-gradient {
    background: linear-gradient(135deg, var(--primary-blue), var(--dark-blue));
  }

  .vision-gradient {
    background: linear-gradient(135deg, var(--dark-blue), var(--primary-blue));
  }

  .timeline-gradient {
    background: linear-gradient(to bottom, 
      var(--primary-blue),
      var(--dark-blue)
    );
  }

  .journey-point-wrapper {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journey-point-inner {
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    position: relative;
    z-index: 3;
    box-shadow: 0 0 0 2px var(--primary-blue);
  }

  .journey-point-outer {
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--primary-blue);
    border-radius: 50%;
    z-index: 2;
  }

  .journey-point-pulse {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary-blue);
    opacity: 0.2;
    z-index: 1;
    animation: journey-pulse 2s ease-out infinite;
  }

  .milestone-card {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .milestone-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(28, 117, 187, 0.2), 0 8px 10px -6px rgba(28, 117, 187, 0.1);
  }

  @keyframes journey-pulse {
    0% {
      transform: scale(1);
      opacity: 0.2;
    }
    50% {
      transform: scale(1.3);
      opacity: 0.1;
    }
    100% {
      transform: scale(1);
      opacity: 0.2;
    }
  }

  .year-badge {
    background: linear-gradient(135deg, var(--primary-blue), var(--dark-blue));
    padding: 0.25rem 1rem;
    border-radius: 1rem;
    box-shadow: 0 2px 4px rgba(28, 117, 187, 0.15);
    transition: all 0.3s ease;
  }

  .milestone-card:hover .year-badge {
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(28, 117, 187, 0.2);
  }

  .glass {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
  }
</style>