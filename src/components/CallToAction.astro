---
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
    title: string;
    description: string;
    buttonText: string;
    buttonLink: string;
    secondaryButtonText?: string;
    secondaryButtonLink?: string;
    theme?: 'light' | 'dark' | 'gradient' | 'brand';
    icon?: string;
}

const { 
    title, 
    description, 
    buttonText, 
    buttonLink, 
    secondaryButtonText, 
    secondaryButtonLink, 
    theme = 'light',
    icon
} = Astro.props;

const themeStyles = {
    light: 'bg-white',
    dark: 'bg-primary-black text-white',
    gradient: 'bg-primary-blue text-white',
    brand: 'bg-primary-blue text-white'
};
---

<section class="py-12 px-4 md:py-16 relative overflow-hidden call-to-action-section">
    <div class="container mx-auto">
        <div class={`${themeStyles[theme]} rounded-2xl shadow-custom-lg mx-auto max-w-6xl overflow-hidden relative`}>
            <!-- Simple dot pattern overlay for texture -->
            <div class="absolute inset-0">
                {(theme !== 'dark') && (
                    <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] [background-size:20px_20px] opacity-25"></div>
                )}
            </div>
            
            <div class="relative z-10 p-10 md:p-16 text-center">
                <div class="max-w-4xl mx-auto">                    
                    {icon && (
                        <div class={`w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center ${theme === 'dark' || theme === 'gradient' || theme === 'brand' ? 'bg-white/20 text-white' : 'bg-primary-blue/10 text-primary-blue'}`}>
                            <Icon name={icon} class="w-8 h-8" />
                        </div>
                    )}
                    
                    <h2 class="text-4xl md:text-5xl font-bold mb-8 text-white drop-shadow-sm">
                        {title}
                    </h2>
                    
                    <p class="text-xl md:text-2xl mb-12 text-white/95 max-w-3xl mx-auto leading-relaxed">
                        {description}
                    </p>
                    
                    <div class="flex flex-col sm:flex-row justify-center space-y-6 sm:space-y-0 sm:space-x-8">
                        <Button 
                            href={buttonLink} 
                            variant="glass"
                            size="lg"
                            class="group transition-all hover:scale-105 hover:shadow-lg bg-white text-primary-blue font-bold border-0 px-10 py-4 text-lg"
                        >
                            <span class="flex items-center">
                                {buttonText}
                                <Icon name="mdi:arrow-right" class="w-6 h-6 ml-2 transition-transform group-hover:translate-x-1" />
                            </span>
                        </Button>
                        
                        {secondaryButtonText && secondaryButtonLink && (
                            <Button 
                                href={secondaryButtonLink} 
                                variant="outline"
                                size="lg"
                                class="bg-transparent text-white border-2 border-white/80 hover:border-white hover:bg-white/10 transition-all hover:scale-105 px-10 py-4 text-lg font-medium"
                            >
                                {secondaryButtonText}
                            </Button>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Removed the grid pattern style as it's no longer needed */
</style>