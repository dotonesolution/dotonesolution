---
// src/components/HeroSection.astro
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  gradientBackground?: string;
  backgroundImage?: string;
  gradientOverlay?: string;
  primaryCta?: {
    text: string;
    link: string;
  };
  secondaryCta?: {
    text: string;
    link: string;
  };
  showScrollIndicator?: boolean;
  variant?: 'default' | 'gradient' | 'dark';
}

const { 
  title,
  subtitle,
  description,
  gradientBackground,
  backgroundImage,
  gradientOverlay,
  primaryCta,
  secondaryCta,
  showScrollIndicator = true,
  variant = 'default'
} = Astro.props;

const useGradient = variant === 'gradient';
const useDark = variant === 'dark';
---

<section 
  class={`relative min-h-[60vh] flex items-center justify-center text-center overflow-hidden pt-16 ${useDark ? 'bg-primary-black' : ''}`}
  id="hero-section"
>
  <!-- Background elements based on variant or section -->
  {backgroundImage && (
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 via-gray-800 to-primary-black z-0">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <!-- Enhanced overlay for better text readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/50 to-black/80"></div>
    </div>
  )}
  
  <div class="container relative z-10 px-4 py-10">
    <div class="max-w-4xl mx-auto" data-aos="fade-up" data-aos-duration="1000">
      {subtitle && (
        <div class="inline-block px-6 py-2 mb-6 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white font-medium text-base tracking-wide transform hover:scale-105 transition-transform">
          {subtitle}
        </div>
      )}
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4 leading-tight text-white" set:html={title}>
      </h1>
      
      <p class="text-base md:text-lg mb-8 leading-relaxed max-w-3xl mx-auto text-gray-300">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-12">
        {primaryCta && (
          <a 
            href={primaryCta.link} 
            class="group py-4 px-8 bg-primary-blue text-white rounded-full font-medium transition-all duration-300 hover:bg-dark-blue shadow-lg hover:shadow-xl hover:shadow-primary-blue/20 transform hover:-translate-y-1 flex items-center justify-center"
          >
            {primaryCta.text}
            <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-2" />
          </a>
        )}
        
        {secondaryCta && (
          <a 
            href={secondaryCta.link} 
            class="group py-4 px-8 border-2 border-white/20 bg-white/10 backdrop-blur-sm text-white rounded-full font-medium transition-all duration-300 hover:bg-white/20 hover:border-white/30 flex items-center justify-center transform hover:-translate-y-1"
          >
            {secondaryCta.text}
          </a>
        )}
      </div>
    </div>
  </div>

  {showScrollIndicator && (
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10 cursor-pointer" id="scroll-indicator">
      <div class="w-8 h-12 rounded-full border-2 border-white/30 flex justify-center items-center">
        <div class="w-1 h-3 bg-white/80 rounded-full animate-scroll-down"></div>
      </div>
    </div>
  )}
</section>

<style>
  .bg-grid-pattern {
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  @keyframes textGradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes scroll-down {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .animate-scroll-down {
    animation: scroll-down 2s ease-in-out infinite;
  }
</style>