---
// src/components/HeroSection.astro
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';
import PageSections from '../data/PageSections.json';

interface Props {
  section: keyof typeof PageSections.sections;
  showScrollIndicator?: boolean;
}

const { section, showScrollIndicator = true } = Astro.props;
const sectionData = PageSections.sections[section];

const backgroundImage = 'backgroundImage' in sectionData ? sectionData.backgroundImage : '';
const gradientOverlay = 'gradientOverlay' in sectionData ? sectionData.gradientOverlay : '';
---

<section 
  class="relative min-h-screen flex items-center justify-center text-center bg-cover bg-center bg-fixed"
  style={`background-image: url('${backgroundImage}');`}
>
  <!-- Overlay with modern gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70 backdrop-blur-sm" style={gradientOverlay ? `background: ${gradientOverlay};` : ''}></div>
  
  <!-- Animated particles background -->
  <div class="absolute inset-0 z-0">
    <div class="particles"></div>
  </div>

  <div class="container relative z-10 px-4">
    <div class="max-w-4xl mx-auto text-white" data-aos="fade-up" data-aos-duration="1000">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
        <span class="bg-gradient-to-r from-white to-gray-300 text-transparent bg-clip-text">
          {sectionData.title}
        </span>
      </h1>
      
      <p class="text-xl md:text-2xl mb-12 text-gray-200 leading-relaxed max-w-3xl mx-auto">
        {sectionData.description}
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 sm:gap-8">
        {'primaryCta' in sectionData && (
          <Button 
            href={sectionData.primaryCta.link} 
            variant="primary"
            class="group text-lg px-8 py-4 rounded-full hover:scale-105 transition-transform duration-300"
          >
            {sectionData.primaryCta.text}
            <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 inline-block transition-transform group-hover:translate-x-1" />
          </Button>
        )}
        
        {'secondaryCta' in sectionData && sectionData.secondaryCta && (
          <Button 
            href={sectionData.secondaryCta.link} 
            variant="secondary"
            class="text-lg px-8 py-4 rounded-full border-2 hover:bg-white/10 transition-colors duration-300"
          >
            {sectionData.secondaryCta.text}
          </Button>
        )}
      </div>
    </div>
  </div>

  {showScrollIndicator && (
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <Icon name="mdi:chevron-down" class="w-8 h-8 text-white/80" />
    </div>
  )}
</section>

<style>
  .particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: transparent;
    pointer-events: none;
  }

  .particles::before,
  .particles::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(circle at center, white 1px, transparent 1px);
    background-size: 50px 50px;
    animation: particleAnimation 60s linear infinite;
    opacity: 0.2;
  }

  .particles::after {
    background-size: 75px 75px;
    animation-duration: 90s;
    animation-delay: -30s;
  }

  @keyframes particleAnimation {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-100%);
    }
  }

  /* Image parallax effect */
  section {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  section::before {
    content: '';
    position: absolute;
    inset: -100px;
    background-image: inherit;
    background-position: center;
    background-size: cover;
    transform: translateZ(-10px) scale(2);
    filter: blur(2px);
    z-index: -1;
  }
</style>

<script>
  // Parallax effect on scroll
  const section = document.querySelector('section');
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    if (section) {
      section.style.backgroundPositionY = `${scrolled * 0.5}px`;
    }
  });
</script>