---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import CallToAction from "../components/CallToAction.astro";
import ServiceList from "../data/ServiceList.json";
import CallToActions from "../data/CallToActions.json";
---

<BaseLayout title="Services">
    <Hero section="services"/>
    <ServiceGrid services={ServiceList.services} />
    <CallToAction {...CallToActions.services} />
</BaseLayout>