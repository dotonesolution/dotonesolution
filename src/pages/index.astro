---
// Import necessary components and data
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import SummarySection from "../components/SummarySection.astro";
import StatsCounter from "../components/StatsCounter.astro";
import StatsData from "../data/StatsData.json";
import SummaryData from "../data/SummaryData.json";
import WhatWeOffer from "../data/WhatWeOffer.json";
---

<!-- Use BaseLayout as the main layout -->
<BaseLayout title="Home">
  <!-- Hero Section -->
  <HeroSection section="home" />

  <!-- Service Grid Section -->
  <ServiceGrid categories={WhatWeOffer.categories} />

  <StatsCounter stats={StatsData.stats}/>

  <!-- Summary Section -->
  <SummarySection 
    heading={SummaryData.heading} 
    text={SummaryData.text} 
    consultationButton={SummaryData.consultationButton} 
    learnMoreButton={SummaryData.learnMoreButton} 
  />

</BaseLayout>