---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import StatsCounter from "../components/StatsCounter.astro";
import CallToAction from "../components/CallToAction.astro";
import company from "../data/company.json";
import services from "../data/services.json";
import pages from "../data/pages.json";

// SEO metadata for the home page
const seoData = {
  title: "Home",
  description: "Dot One Solutions - Your trusted partner for innovative tech services. We specialize in software development, digital transformation, and IT consulting to help businesses thrive in the digital age.",
  type: "website",
  keywords: [
    "tech solutions",
    "software development company",
    "IT consulting services",
    "digital transformation",
    "web development",
    "cloud solutions",
    "business technology",
    "custom software development",
    "IT services",
    "technology consulting"
  ],
  publishedDate: "2024-01-01",
  modifiedDate: new Date().toISOString()
};

// Extract CTA data and ensure it matches the component interface
const ctaData = {
  ...pages.sections.home.cta,
  theme: pages.sections.home.cta.theme as 'light' | 'dark' | 'gradient' | 'brand'
};
---

<BaseLayout {...seoData}>
  <!-- Hero Section -->
  <HeroSection {...pages.sections.home.hero} />

  <!-- About Section -->
  <AboutSection />

  <!-- Service Grid Section -->
  <ServiceGrid categories={services.categories} />

  <StatsCounter stats={company.stats}/>

  <!-- Call to Action Section -->
  <CallToAction {...ctaData} />
</BaseLayout>

<style>
  /* Enhanced vibrant styles for the CTA section */
  :global(.call-to-action-section) {
    --gradient-start: #1C75BB;
    --gradient-end: #144C7F;
  }
</style>