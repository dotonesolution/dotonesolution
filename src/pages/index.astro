---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import StatsCounter from "../components/StatsCounter.astro";
import CallToAction from "../components/CallToAction.astro";
import company from "../data/company.json";
import services from "../data/services.json";
import pages from "../data/pages.json";
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <HeroSection {...pages.sections.home.hero} />

  <!-- About Section -->
  <AboutSection />

  <!-- Service Grid Section -->
  <ServiceGrid categories={services.categories} />

  <StatsCounter stats={company.stats}/>

  <!-- Call to Action Section -->
  <CallToAction {...pages.sections.home.cta} />
</BaseLayout>

<style>
  /* Enhanced vibrant styles for the CTA section */
  :global(.call-to-action-section) {
    --gradient-start: #1C75BB;
    --gradient-end: #144C7F;
  }
  
  :global(.call-to-action-section .rounded-2xl) {
    background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
    box-shadow: 0 10px 25px -5px rgba(28, 117, 187, 0.4), 0 8px 10px -6px rgba(28, 117, 187, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>