---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CompanyProfile from "../components/CompanyProfile.astro";
import StatsCounter from "../components/StatsCounter.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import CallToAction from "../components/CallToAction.astro";
import CompanyInfo from "../data/CompanyInfo.json";
import StatsData from "../data/StatsData.json";
import CallToActions from "../data/CallToActions.json";
---

<BaseLayout title="About">
    <Hero section="about" />
    <CompanyProfile 
        mission={CompanyInfo.mission}
        vision={CompanyInfo.vision}
        journey={CompanyInfo.journey}
    />
    <WhyChooseUs 
        title={CompanyInfo.whyChooseUs.title}
        points={CompanyInfo.whyChooseUs.points}
    />
    <StatsCounter stats={StatsData.stats} />
    <CallToAction {...CallToActions.about} />
</BaseLayout>