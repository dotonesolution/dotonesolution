---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CompanyProfile from "../components/CompanyProfile.astro";
import StatsCounter from "../components/StatsCounter.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import CallToAction from "../components/CallToAction.astro";
import company from "../data/company.json";
import pages from "../data/pages.json";
---

<BaseLayout title="About">
    <Hero {...pages.sections.about.hero} />
    <CompanyProfile 
        mission={company.mission}
        vision={company.vision}
        journey={company.journey}
    />
    <WhyChooseUs 
        title={company.whyChooseUs.title}
        points={company.whyChooseUs.points}
    />
    <StatsCounter stats={company.stats} />
    <CallToAction {...pages.sections.about.cta} />
</BaseLayout>