---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You">
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center p-8">
      <h1 class="text-4xl font-bold text-primary-blue mb-4">Thank You!</h1>
      <p class="text-xl text-gray-700 mb-4">Your message has been sent successfully.</p>
      <p class="text-gray-600">Redirecting you to homepage...</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Redirect to home page after 3 seconds
  setTimeout(() => {
    window.location.href = '/';
  }, 3000);
</script>