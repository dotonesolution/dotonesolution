---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/responsive.css';

// Import Material Design Icons CSS
import '@mdi/font/css/materialdesignicons.min.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Dot One Solutions - Empowering businesses with expert tech services"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Dot One Solutions</title>
    <meta name="description" content={description} />

    <!-- Open Graph for SEO -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/og-image.png" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card for SEO -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/og-image.png" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main class="flex-grow">
      {title && <h1 class="sr-only">{title}</h1>}
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Fallback for No JavaScript -->
    <noscript>
      <link rel="stylesheet" href="/styles/fallback.css" />
    </noscript>
  </body>
</html>
