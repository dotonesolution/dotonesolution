---
// src/components/ServiceCard.astro
import Card from './Card.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  learnMoreLink: string;
}

const { title, description, icon, learnMoreLink } = Astro.props;
---

<Card
  title={title}
  description={description}
  icon={icon}
  class="hover:bg-gray-50"
>
  <div class="mt-4">
    <Button href={learnMoreLink} variant="outline" class="w-full">
      Learn More
    </Button>
  </div>
</Card>